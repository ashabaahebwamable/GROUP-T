# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must NEVER be committed.
# This file holds PLACEHOLDERS ONLY - no real keys, tokens or passwords.

MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

APP_ENV=development
LOG_LEVEL=info

# Bounded-agent limits (set in Week 5)
MAX_AGENT_ITERATIONS=6
MAX_TOOL_RETRIES=1
